@baseUrl = http://localhost:3000
@adminToken = replace-with-local-test-token

### Checkout simulado — sucesso
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Guilherme",
  "eml": "gui@example.test",
  "pwd": "senha-local-de-teste",
  "c_id": 2,
  "card": "4000000000000000"
}

### Checkout simulado — pagamento recusado
POST {{baseUrl}}/api/checkout
Content-Type: application/json

{
  "usr": "Teste",
  "eml": "recusado@example.test",
  "pwd": "senha-local-de-teste",
  "c_id": 1,
  "card": "5000000000000000"
}

### Relatório financeiro administrativo
GET {{baseUrl}}/api/admin/financial-report
Authorization: Bearer {{adminToken}}

### Anonimizar usuário
DELETE {{baseUrl}}/api/users/1
Authorization: Bearer {{adminToken}}
